{
  "name": "pokerevolutionpacks",
  "productName": "PokeRevolution Packs",
  "version": "1.0.1",
  "description": "A realistic Pokemon TCG pack simulator for Ascended Heroes, with a collection binder, live market values, and pack rewards earned from Pokemon Revolution Online progress.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "mitchk1995",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitchk1995/pokerevolutionpacks.git"
  },
  "bugs": {
    "url": "https://github.com/Mitchk1995/pokerevolutionpacks/issues"
  },
  "homepage": "https://github.com/Mitchk1995/pokerevolutionpacks#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "electron tools/smoke.js",
    "build:data": "node tools/run-python.mjs tools/build_data.py",
    "build:images": "node tools/run-python.mjs tools/fetch_images.py assets/cards data/cards.me2pt5.json",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mitchk1995.pokerevolutionpacks",
    "productName": "PokeRevolution Packs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PokeRevolution-Packs-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PokeRevolution Packs"
    },
    "portable": {
      "artifactName": "PokeRevolution-Packs-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
